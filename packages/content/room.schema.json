{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "room.schema.json",
  "title": "Room",
  "description": "A room for @sci-ts/content: what's in it. What's said in it lives in the matching .yarn file (nodes named <thing>.<verb>).",
  "type": "object",
  "required": [
    "room"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y] in room coordinates"
    },
    "rect": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[left, top, right, bottom] in room coordinates"
    },
    "polygon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 3
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "feature": {
      "type": "object",
      "required": [
        "rect"
      ],
      "properties": {
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "at": {
          "$ref": "#/$defs/point",
          "description": "Where the hero looks at (default: the middle of rect)"
        },
        "approach": {
          "$ref": "#/$defs/point",
          "description": "Where the hero walks to before interacting"
        },
        "sightAngle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360,
          "default": 180
        }
      }
    }
  },
  "properties": {
    "room": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Room (script and message) number"
    },
    "picture": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Picture number (default: the room number)"
    },
    "music": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Music played (looping) here; left alone if it's already playing"
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/point",
          "description": "Where the hero appears"
        },
        "enterTo": {
          "$ref": "#/$defs/point",
          "description": "Walk here on arrival; room.enter is narrated after"
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "front",
            "back",
            "frontY",
            "backY"
          ],
          "description": "Perspective for the hero alone: front% at y frontY, back% at y backY (perspective: is simpler)",
          "properties": {
            "front": {
              "type": "integer"
            },
            "back": {
              "type": "integer"
            },
            "frontY": {
              "type": "integer"
            },
            "backY": {
              "type": "integer"
            }
          }
        }
      }
    },
    "perspective": {
      "description": "How people are sized by where they stand: a level camera's horizon and full-size line, or sizes measured at up to three places across the floor (for a picture painted at an angle)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "horizon",
            "fullSize"
          ],
          "properties": {
            "horizon": {
              "type": "integer",
              "description": "The y the floor's lines meet at"
            },
            "fullSize": {
              "type": "integer",
              "description": "The y of a figure's feet where it's drawn at full size"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "back",
                  "front"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "description": "Where across the floor it was measured"
                  },
                  "back": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[y, size in percent] at the back of the floor"
                  },
                  "front": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[y, size in percent] at the front of the floor"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "walkable": {
      "$ref": "#/$defs/polygon",
      "description": "The floor: the hero stays inside"
    },
    "obstacles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/polygon"
      },
      "description": "Polygons the hero walks around"
    },
    "features": {
      "type": "object",
      "description": "Things to look at and use, drawn in the picture",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/feature"
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "exits": {
      "type": "object",
      "description": "Features that lead to another room when used (Do)",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/feature"
          }
        ],
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "type": "integer",
            "description": "The room to go to"
          },
          "walkTo": {
            "$ref": "#/$defs/point",
            "description": "Walk here before leaving"
          }
        },
        "unevaluatedProperties": false
      }
    },
    "props": {
      "type": "object",
      "description": "Things drawn with a view (sprite), optionally animated",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "view",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "view": {
            "type": "integer",
            "description": "View number (e.g. from a .view.json)"
          },
          "at": {
            "$ref": "#/$defs/point"
          },
          "loop": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "cel": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "cycle": {
            "enum": [
              "forward"
            ],
            "description": "forward: loop the animation forever"
          },
          "sightAngle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 360,
            "default": 180
          },
          "moves": {
            "type": "boolean",
            "description": "It walks or floats about in cutscenes (<<walk name x y>>): an Actor instead of a Prop"
          },
          "script": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "A Script class of the game's: an instance of it runs on the prop, e.g. an ambient behaviour"
          },
          "scale": {
            "type": "boolean",
            "description": "Sized by the room's perspective (default: if it moves). A still prop is sized once, for where it is."
          }
        }
      }
    },
    "characters": {
      "type": "object",
      "description": "Who speaks in this room's Yarn besides Narrator and Hero (`Wisp: ...`)",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "description": "Another name they go by in Yarn (besides the key)"
          },
          "portrait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Portrait view: loop 0 bust, loop 1 mouth shapes, loop 2 eyes; same-size cels anchored at [0, 0]. Without one: a plain text box"
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "description": "Raw property values per object (the room is \"room\"), for anything not covered above",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    }
  }
}
